<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App-target entitlements.
   • App Group  — lets the widget read the app's snapshot.
   • iCloud/CloudKit — SwiftData syncs the diary records (F11). On a free account
     that can't provision iCloud, the app falls back to a local store at runtime
     (see Persistence.swift), so it still runs; only cross-device sync is off.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.suixinji.mj</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.suixinji.mj</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>

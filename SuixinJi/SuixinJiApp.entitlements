<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App-target entitlements. The App Group lets the widget read the app's snapshot.
  (To also enable iCloud sync, add the CloudKit keys from SuixinJi.entitlements
   here — a target can only reference one entitlements file.)
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.suixinji.app</string>
	</array>
</dict>
</plist>

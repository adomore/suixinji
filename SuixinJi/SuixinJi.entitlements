<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iCloud / CloudKit entitlements for the P2 sync feature (F11).

  This file is NOT wired into the build by default, so the app still builds &
  signs with a free Apple ID. To turn on iCloud sync:
    1. Xcode → target SuixinJi → Signing & Capabilities → + Capability → iCloud
       → check CloudKit, and set the container to iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)
       (or point CODE_SIGN_ENTITLEMENTS at this file and edit the id below).
    2. Build Settings → Active Compilation Conditions → add CLOUDKIT_ENABLED
       (Debug + Release) so SuixinJiApp uses the CloudKit ModelConfiguration.
    3. Use a paid Apple Developer account (CloudKit requires it).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.suixinji.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
